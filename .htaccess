# ------------------------------------------------------------------
# Solutic3e - configuración del servidor (Apache / LiteSpeed)
# ------------------------------------------------------------------

# Página de inicio
DirectoryIndex index.php index.html

# No listar el contenido de carpetas sin index
Options -Indexes

RewriteEngine On

# Bloquear acceso directo a los fragmentos PHP
RewriteRule ^partials/ - [F,L]

# /index.php y /index.html -> /  (una sola URL para la página de inicio)
RewriteCond %{THE_REQUEST} \s/index\.(php|html)[\s?]
RewriteRule ^index\.(php|html)$ / [R=301,L]

# Páginas antiguas .html -> .php (301 conserva el posicionamiento en Google)
RewriteRule ^(sobrenosotros|productos|servicios|cookies|politica_de_datos|agradecimiento)\.html$ /$1.php [R=301,L]

# Bloquear archivos sensibles por si alguno llega a public_html
<FilesMatch "\.(log|bk|bak|sql|ini|env)$">
  Require all denied
</FilesMatch>
